# Handshake tooling — environment template. NEVER commit real keys or keystore passwords.

# ---------- RPC URLs (HTTP; env overrides the canonical public defaults) ----------
REACTIVE_RPC=https://lasna-rpc.rnk.dev/
BASE_RPC=https://sepolia.base.org
UNICHAIN_RPC=https://sepolia.unichain.org

# WebSocket endpoints used by ts/observe.ts. Defaults are derived from the HTTP URLs.
REACTIVE_WS=wss://lasna-rpc.rnk.dev/
BASE_WS=wss://sepolia.base.org
UNICHAIN_WS=wss://sepolia.unichain.org

# ---------- Deployed addresses (set after script/Deploy.s.sol runs) ----------
RC_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
ASSET_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENT_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000
ASSET_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# Wallet addresses used by scripts/preflight.sh (no private keys)
DEPLOYER_ADDRESS=
BUYER_ADDRESS=
SELLER_ADDRESS=

# ---------- Foundry keystore account used for all cast send commands ----------
# Example: forge script ... --account main --broadcast
FOUNDRY_ACCOUNT=main

# ---------- Optional market overrides (see MARKET-DEPLOYMENT.md) ----------
# Leave unset for the current Base Sepolia payment / Unichain Sepolia asset market.
# REACTIVE_CHAIN_ID_OVERRIDE=5318007
# PAYMENT_CHAIN_ID_OVERRIDE=84532
# ASSET_CHAIN_ID_OVERRIDE=1301
# PAYMENT_PROXY_OVERRIDE=0x476F44b11F5C942c58f4c8E3d0300E5710743585
# ASSET_PROXY_OVERRIDE=0x775c9B990ADe401060B78D0e98684eEf8d2466C1
# PAYMENT_RPC=https://sepolia.base.org          # falls back to BASE_RPC when unset
# ASSET_RPC=https://sepolia.unichain.org        # falls back to UNICHAIN_RPC when unset

# ---------- Funding amounts (wei) ----------
RC_DEPLOY_VALUE_WEI=50000000000000000
RC_FUND_AMOUNT_WEI=1000000000000000000
PAYMENT_RESERVE_WEI=20000000000000000
ASSET_RESERVE_WEI=20000000000000000

# ---------- Preflight thresholds ----------
MIN_LASNA_BALANCE=100000000000000000
MIN_BASE_BALANCE=10000000000000000
MIN_UNICHAIN_BALANCE=5000000000000000
MIN_ACTIVE_SUBSCRIPTIONS=7
SUBSCRIPTION_LOOKBACK_BLOCKS=300000

# ---------- Proof collection ----------
PROOF_LOOKBACK_BLOCKS=200000

# ---------- Node deployment signer (ts/deploy.ts only) ----------
# WARNING: prefer the Foundry keystore scripts (--account main); they never read a raw key.
# ts/deploy.ts is only a fallback and requires PRIVATE_KEY from your shell/dotenv.
# If a raw key is absolutely needed, keep it OUT of this file and out of git. Never commit it.
# PRIVATE_KEY=0x...
