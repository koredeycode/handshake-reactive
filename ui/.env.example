# Handshake UI — Vite build-time settings. Copy to .env.local for dev; never commit secrets.

# Optional private/primary RPC URLs. Each becomes the first fallback hop for its chain.
VITE_BASE_RPC=
VITE_UNICHAIN_RPC=
VITE_LASNA_RPC=

# Optional build-time address overrides (forward/default market only). Normally
# leave these unset; addresses are read at runtime from public/contracts.json.
# VITE_RC_ADDRESS=
# VITE_SYSTEM_ADDRESS=
# VITE_LEGACY_SYSTEM_ADDRESS=
# VITE_PAYMENT_ESCROW=
# VITE_PAYMENT_TOKEN=
# VITE_BASE_PROXY=
# VITE_ASSET_ESCROW=
# VITE_ASSET_TOKEN=
# VITE_UNICHAIN_PROXY=
# VITE_LASNA_FROM_BLOCK=
# VITE_BASE_FROM_BLOCK=
# VITE_UNICHAIN_FROM_BLOCK=
# VITE_LOOKBACK_BLOCKS=

# Enables the hidden /dev diagnostics route in a production build.
# VITE_DEV_TOOLS=1

# Optional WalletConnect Cloud project ID (free from https://cloud.walletconnect.com).
# When set, the header offers both Browser wallet (injected) and WalletConnect.
# Injected-only cannot connect some mobile in-app browsers (e.g. Zerion's),
# because they do not expose window.ethereum. Leave unset for injected-only.
# VITE_WALLETCONNECT_PROJECT_ID=
