# Copy to api/.env for local development. Fly secrets are set with `fly secrets set`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/handshake
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Dedicated per-chain providers are recommended (public endpoints are rate limited).
REACTIVE_RPC=https://lasna-rpc.rnk.dev/
REACTIVE_WS=wss://lasna-rpc.rnk.dev/
BASE_RPC=https://base-sepolia-rpc.publicnode.com
BASE_WS=wss://base-sepolia-rpc.publicnode.com
UNICHAIN_RPC=https://unichain-sepolia-rpc.publicnode.com
UNICHAIN_WS=wss://unichain-sepolia-rpc.publicnode.com
SEPOLIA_RPC=https://sepolia.gateway.tenderly.co
SEPOLIA_WS=wss://ethereum-sepolia-rpc.publicnode.com

# Operator error alerts only. NEVER set a keeper signing key in this app.
# Without RESEND_API_KEY + OPERATOR_ALERT_EMAIL, alerts are logged only.
# RESEND_API_KEY=
# OPERATOR_ALERT_EMAIL=you@example.com
ALERT_FROM_EMAIL=Handshake Alerts <alerts@resend.dev>

# Extra CORS origins (comma separated). *.vercel.app is always allowed.
CORS_ORIGINS=

MAX_SSE_CONNECTIONS=1000
MAX_SSE_PER_IP=10
SSE_BUFFER_SIZE=256
OUTBOX_RETENTION_DAYS=7
STALE_EVENT_MS=300000
WALLET_CACHE_TTL_MS=15000
NOTIFICATION_COOLDOWN_MS=300000
ALERT_DEDUPE_MS=600000
OUTBOX_BACKLOG_ALERT=1000

# Optional starting blocks for a fresh indexer_state row (otherwise head-lookback).
# START_BLOCK_5318007=
# START_BLOCK_84532=
# START_BLOCK_1301=
# START_BLOCK_11155111=

# Optional live-address overrides (defaults mirror the root deployments.json).
# RC_ADDRESS=
# SYSTEM_CONTRACT=
# UNICHAIN_PAYMENT_ESCROW_ADDRESS=
# UNICHAIN_ASSET_ESCROW_ADDRESS=
# SEPOLIA_PAYMENT_ESCROW_ADDRESS=
# SEPOLIA_ASSET_ESCROW_ADDRESS=
