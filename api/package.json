{
  "name": "handshake-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Handshake public read API, SSE stream and 4-chain log indexer (API + indexer in one process)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "prom-client": "^15.1.3",
    "resend": "^6.40.1",
    "viem": "^2.58.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
